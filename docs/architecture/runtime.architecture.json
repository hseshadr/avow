  "cards": [
    {
      "dot": "cyan",
      "title": "Portable proof",
      "items": [
        "Python and TypeScript share canonicalization and receipt semantics",
        "A receipt remains independently verifiable without a service or database"
      ]
    },
    {
      "dot": "rose",
      "title": "Pinned trust",
      "items": [
        "Verification recomputes the hash before checking signer identity and signature bytes",
        "The embedded public key is never accepted as its own trust anchor"
      ]
    },
    {
      "dot": "amber",
      "title": "Explicit limits",
      "items": [
        "Signing proves who signed unchanged bytes, not truth, freshness, or fairness",
        "Replay defense requires caller state or the optional Python ledger"
      ]
    }
  ]
