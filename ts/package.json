{
  "name": "@edgeproc/avow",
  "version": "0.4.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Browser-side Avow trust kernel: RFC-8785 canonical bytes + Ed25519 sign/verify, plus recall@k / MRR / confusion-set metrics — all kept identical to the Python avow+assay faces by shared golden vectors.",
  "keywords": [
    "ed25519",
    "rfc8785",
    "jcs",
    "canonical-json",
    "signed-receipt",
    "digital-signature",
    "tamper-evident",
    "offline-verification",
    "provenance",
    "audit-log",
    "cryptography",
    "browser",
    "typescript",
    "metrics",
    "recall-at-k",
    "precision-at-k",
    "mrr",
    "confusion-matrix",
    "information-retrieval",
    "evaluation"
  ],
  "license": "MIT",
  "author": "Harish Seshadri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hseshadr/assay.git",
    "directory": "ts"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "benchmarks"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "benchmark": "tsc -p tsconfig.build.json && node benchmarks/release.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "gate": "biome check . && tsc -p tsconfig.json --noEmit && vitest run --coverage && tsc -p tsconfig.build.json && node benchmarks/release.mjs"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "canonicalize": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7"
  }
}
